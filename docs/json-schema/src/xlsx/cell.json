{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setCellOp": [
      "xlsx"
    ],
    "setCellStyleOp": [
      "xlsx"
    ],
    "setColWidthOp": [
      "xlsx"
    ],
    "setRowHeightOp": [
      "xlsx"
    ],
    "mergeRangeOp": [
      "xlsx"
    ],
    "unmergeRangeOp": [
      "xlsx"
    ],
    "insertCellStyleOp": [
      "xlsx"
    ],
    "deleteCellStyleOp": [
      "xlsx"
    ],
    "setCellNamedStyleOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "setCellOp": {
      "description": "改一个单元格的值或公式。",
      "descriptionEn": "Change a cell's value or formula.",
      "limits": "value 和 formula 二选一，不能同时出现。arrayRef、sharedRef、dataTableRef 只能出现一个，shared 与 array 也不能同时为真。新建数据表要同时给 TABLE 公式和 dataTableRef。不改超链接，不改迷你图。不要把共享公式的从属格当成主格来写。",
      "limitsEn": "Give exactly one of value and formula; they cannot both appear. At most one of arrayRef, sharedRef, and dataTableRef may appear, and shared and array cannot both be true. A new data table needs both a TABLE formula and dataTableRef. Do not change hyperlinks or sparklines. Do not write a shared formula's dependent cell as if it were the master cell.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCell"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        },
        "shared": {
          "type": "boolean"
        },
        "sharedRef": {
          "type": "string",
          "minLength": 1
        },
        "array": {
          "type": "boolean"
        },
        "arrayRef": {
          "type": "string",
          "minLength": 1
        },
        "dataTableRef": {
          "description": "新建数据表的结果区域。主格必须是左上角。与已有区域不同则不写。",
          "descriptionEn": "Result range of a new data table. The master cell must be the top-left. A different range on an existing table is rejected.",
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "formula"
          ]
        }
      ]
    },
    "cellColor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rgb": {
          "description": "6 位或 8 位十六进制。写入时改为大写；6 位前面补 FF。",
          "descriptionEn": "6 or 8 hex digits. Written in uppercase; 6 digits get an FF prefix.",
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "theme": {
          "type": "integer",
          "minimum": 0
        },
        "indexed": {
          "type": "integer",
          "minimum": 0
        },
        "tint": {
          "type": "number"
        }
      }
    },
    "cellBorderSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/cellColor"
        }
      }
    },
    "cellFont": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 409
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": [
            "boolean",
            "string",
            "null"
          ]
        },
        "color": {
          "$ref": "#/$defs/cellColor"
        }
      }
    },
    "cellFill": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "fg": {
          "$ref": "#/$defs/cellColor"
        },
        "bg": {
          "$ref": "#/$defs/cellColor"
        }
      }
    },
    "cellBorder": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/cellColor"
        },
        "left": {
          "$ref": "#/$defs/cellBorderSide"
        },
        "right": {
          "$ref": "#/$defs/cellBorderSide"
        },
        "top": {
          "$ref": "#/$defs/cellBorderSide"
        },
        "bottom": {
          "$ref": "#/$defs/cellBorderSide"
        },
        "diagonal": {
          "$ref": "#/$defs/cellBorderSide"
        },
        "diagonalUp": {
          "type": "boolean"
        },
        "diagonalDown": {
          "type": "boolean"
        }
      }
    },
    "cellAlign": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "horizontal": {
          "type": "string",
          "minLength": 1
        },
        "vertical": {
          "type": "string",
          "minLength": 1
        },
        "wrap": {
          "type": "boolean"
        },
        "indent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        },
        "rotation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "shrink": {
          "type": "boolean"
        }
      }
    },
    "setCellStyleOp": {
      "description": "写单元格的数字格式、字体、填充、边框与对齐。",
      "descriptionEn": "Write a cell's number format, font, fill, border, and alignment.",
      "limits": "不改值、不改公式。",
      "limitsEn": "Does not change the value or the formula.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCellStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "numFmt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/cellFont"
        },
        "fill": {
          "$ref": "#/$defs/cellFill"
        },
        "border": {
          "$ref": "#/$defs/cellBorder"
        },
        "align": {
          "$ref": "#/$defs/cellAlign"
        }
      },
      "anyOf": [
        {
          "required": [
            "numFmt"
          ]
        },
        {
          "required": [
            "font"
          ]
        },
        {
          "required": [
            "fill"
          ]
        },
        {
          "required": [
            "border"
          ]
        },
        {
          "required": [
            "align"
          ]
        }
      ]
    },
    "setColWidthOp": {
      "description": "写工作表列宽。",
      "descriptionEn": "Write a worksheet column width.",
      "limits": "JSON 的 width 是 Excel 列宽字符数（与 COM ColumnWidth 同一套），不是像素。写入 col/@width 时按 ECMA-376 §18.3.1.13 的公式转换；MDW 固定用该节示例的 Calibri 11 点 7 像素，不读实际字体、不算最适列宽。",
      "limitsEn": "JSON width is the Excel column-width character count (the same scale as COM ColumnWidth), not pixels. When writing col/@width, convert with the formula in ECMA-376 §18.3.1.13. MDW is fixed at that section's example, Calibri 11 pt and 7 pixels. The actual font is not read, and best-fit width is not calculated.",
      "type": "object",
      "required": [
        "op",
        "id",
        "col"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setColWidth"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 255
        },
        "bestFit": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "width"
          ]
        },
        {
          "required": [
            "bestFit"
          ]
        }
      ]
    },
    "setRowHeightOp": {
      "description": "写行高。",
      "descriptionEn": "Write a row height.",
      "limits": "单位磅，对应 row/@ht。不算自动换行后的高度。",
      "limitsEn": "The unit is points, stored in row/@ht. Wrapped-text height is not calculated.",
      "type": "object",
      "required": [
        "op",
        "id",
        "row",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setRowHeight"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "toRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "height": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 409
        }
      }
    },
    "mergeRangeOp": {
      "description": "合并工作表单元格。",
      "descriptionEn": "Merge worksheet cells.",
      "limits": "不要跟 Word 表的 mergeCells 混用。",
      "limitsEn": "Do not confuse this with Word table mergeCells.",
      "type": "object",
      "required": [
        "op",
        "id",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "mergeRange"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unmergeRangeOp": {
      "description": "取消合并。",
      "descriptionEn": "Unmerge cells.",
      "limits": "不恢复合并时清掉的值。",
      "limitsEn": "Does not restore values cleared by the merge.",
      "type": "object",
      "required": [
        "op",
        "id",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "unmergeRange"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertCellStyleOp": {
      "description": "往 styles.xml 追加一条命名单元格样式。",
      "descriptionEn": "Append one named cell style to styles.xml.",
      "limits": "不套到任何格子上。",
      "limitsEn": "Does not apply the style to any cell.",
      "type": "object",
      "required": [
        "op",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertCellStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "numFmt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "font": {
          "$ref": "#/$defs/cellFont"
        },
        "fill": {
          "$ref": "#/$defs/cellFill"
        },
        "border": {
          "$ref": "#/$defs/cellBorder"
        },
        "align": {
          "$ref": "#/$defs/cellAlign"
        }
      },
      "anyOf": [
        {
          "required": [
            "numFmt"
          ]
        },
        {
          "required": [
            "font"
          ]
        },
        {
          "required": [
            "fill"
          ]
        },
        {
          "required": [
            "border"
          ]
        },
        {
          "required": [
            "align"
          ]
        }
      ]
    },
    "deleteCellStyleOp": {
      "description": "删掉一条命名单元格样式。",
      "descriptionEn": "Delete one named cell style.",
      "limits": "不删 cellStyleXfs，不改格子上已有 s。",
      "limitsEn": "Does not delete cellStyleXfs and does not change s already on cells.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteCellStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setCellNamedStyleOp": {
      "description": "把单元格的 s 指到一条引用该命名样式 xfId 的 cellXfs。",
      "descriptionEn": "Point the cell's s at a cellXfs entry that references that named style's xfId.",
      "type": "object",
      "required": [
        "op",
        "id",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCellNamedStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
